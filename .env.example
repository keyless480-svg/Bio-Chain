# === DATABASE ===
DATABASE_URL=postgresql+pg8000://user:password@host.pooler.supabase.com:6543/postgres

# === SECURITY ===
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === OPTIMIZATION ===
SOLVER_TIMEOUT=300
CARBON_TAX_DEFAULT=0.03
# Solver: glpk | cbc
MILP_SOLVER=cbc

# === API ===
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# === ENVIRONMENT ===
ENVIRONMENT=development
